# RPC endpoint for the target chain
# Base Mainnet: https://mainnet.base.org
# Base Sepolia: https://sepolia.base.org
RPC_URL=https://sepolia.base.org

# Private key of the keeper wallet (no 0x prefix)
KEEPER_PRIVATE_KEY=0x99aa4ee439776e9fceff819cddb455df5b93f9855197126ddb9f3394712122f3

# Pyth on-chain contract address
# Base Mainnet: 0x8250f4aF4B972684F7b336503E2D6dFeDeB1487a
# Base Sepolia: 0xA2aa501b19aff244D90cc15a4Cf739D2725B5729
PYTH_ADDRESS=0x8250f4aF4B972684F7b336503E2D6dFeDeB1487a

# Pyth Hermes API endpoint (default: public endpoint)
HERMES_URL=https://hermes.pyth.network

# Comma-separated list of bToken addresses to monitor
# bwtCOIN address (fill after oracle deployment)
BTOKEN_ADDRESSES=

# Comma-separated list of corresponding Pyth price feed IDs (hex, 0x-prefixed)
# wtCOIN (COIN/USD): 0xfee33f2a978bf32dd6b662b65ba8083c6773b494f8401194ec1870c640860245
PYTH_PRICE_IDS=0xfee33f2a978bf32dd6b662b65ba8083c6773b494f8401194ec1870c640860245

# Update interval in seconds (default: 30)
UPDATE_INTERVAL_SEC=30

# Maximum price age on-chain before triggering a staleness alert (seconds)
MAX_PRICE_AGE_SEC=3600

# Price deviation threshold to trigger an update (basis points, 50 = 0.5%)
PRICE_DEVIATION_BPS=50

# Force update if on-chain price is older than this (seconds, safety net)
MAX_STALENESS_BEFORE_FORCE_UPDATE_SEC=1800

# Only update during US stock market hours: Mon-Fri 9:30AM-4:00PM ET (true/false)
MARKET_HOURS_ONLY=true

# Dry run mode: fetch and log prices without submitting transactions (true/false)
DRY_RUN=false
